# Server-only values. Never prefix the API key with VITE_.
# Local development can use API_KEY from the repository root .env automatically.
API_BASE_URL=http://localhost:3000
API_KEY=replace-with-the-same-api-key-as-your-backend
WEB_PORT=5173

# In Vercel, set API_BASE_URL to your HTTPS Render URL and API_KEY to its key.