NODE_ENV=development
PORT=3000

# Local PostgreSQL; create the clinic database before running migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinic
# For Neon, replace the URL above with your real connection string using verified TLS:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# Replace with a randomly generated secret containing at least 32 characters.
API_KEY=replace-with-a-random-64-character-hex-secret

# Explicit comma-separated browser origins. Empty disables cross-origin browser clients.
CORS_ORIGINS=http://localhost:5173

# Optional seed settings. Default: 16 half-hour slots tomorrow starting at 09:00 UTC.
SEED_SLOT_COUNT=16
# SEED_START=2030-01-01T09:00:00.000Z

# Optional dedicated database for integration tests (set in your shell, not this file).
# When unset, npm run test:integration uses disposable embedded PostgreSQL.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinic_test