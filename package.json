{
  "name": "simple-clinic-booking-api",
  "version": "1.0.0",
  "private": true,
  "description": "Transactional clinic appointment booking API",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node scripts/test-integration.js",
    "check": "node scripts/check.js",
    "web:dev": "npm --prefix frontend run dev",
    "web:build": "npm --prefix frontend run build",
    "web:test": "npm --prefix frontend test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "validator": "^13.15.23"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  }
}